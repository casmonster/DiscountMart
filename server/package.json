{
  "name": "discountmart-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "build/index.js",
  "scripts": {
    "dev": "(echo 'Killing port 5000...'; fuser -k 5000/tcp || true) && nodemon --exec tsx index.ts",
    "start": "node build/index.js",
    "build": "tsc",
    "db:generate": "drizzle-kit generate:pg",
    "db:migrate": "drizzle-kit migrate",
    "generate": "drizzle-kit generate --config=../drizzle.config.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.5.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "drizzle-orm": "^0.44.2",
    "drizzle-zod": "^0.8.2",
    "express": "^5.1.0",
    "lodash.debounce": "^4.0.8",
    "next": "^15.3.3",
    "pg": "^8.16.2",
    "ws": "^8.18.2",
    "zod": "^3.25.42"
  },
  "devDependencies": {
    "@alloc/quick-lru": "^5.2.0",
    "@types/cors": "^2.8.19",
    "@types/dotenv": "^6.1.1",
    "@types/estree": "^1.0.8",
    "@types/express": "^5.0.3",
    "@types/lodash.debounce": "^4.0.9",
    "@types/node": "^22.15.33",
    "@types/pg": "^8.15.4",
    "@types/react": "18.3.23",
    "@types/react-dom": "^18.3.7",
    "autoprefixer": "^10.4.21",
    "drizzle-kit": "^0.31.3",
    "nodemon": "^3.1.10",
    "postcss": "^8.5.6",
    "rollup": "^4.44.1",
    "rollup-plugin-visualizer": "^6.0.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.4",
    "typescript": "^5.0.0",
    "vite": "^6.3.5"
  },
  "generate": {
    "./drizzle.config.ts": true
  }
}
