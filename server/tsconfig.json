{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "outDir": "./build",
    "preserveSymlinks": true,
    "noEmit": false,
    "resolveJsonModule": true,
    "noImplicitAny": true,
      "paths": {
      "@shared/*": ["server/*"],
      "@/*": ["./*"]
    },
    "types": ["node"]
  },
  "include": [
    "./**/*",
    "../shared/**/*",
    "vite.config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
