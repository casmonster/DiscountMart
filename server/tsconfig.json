{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "outDir": "./build",
    "rootDir": "./src",  
    "preserveSymlinks": true,
    "resolveJsonModule": true,
    "noImplicitAny": true,
    "types": ["node"],
      "paths": {
      "@shared/*": ["../../shared/*"],
      "@/*": ["./*"],
      "@server/*": ["./src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules","dist"]
}
