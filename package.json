{
  "name": "discountmart",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm --prefix client run dev\" \"npm --prefix server run dev\"",
    "build": "npm run build --workspace client && npm run build --workspace server",
    "start": "npm run start --workspace server",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "seed": "tsx server/seed.ts",
    "generate": "drizzle-kit generate --config=drizzle.config.ts"
  },
  "devDependencies": {
    "@types/node": "^22.15.29",
    "@vitejs/plugin-react": "^4.0.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^8.2.2",
    "drizzle-kit": "^0.31.1",
    "postcss": "^8.5.6",
    "postcss-loader": "^8.1.1",
    "tailwindcss": "^4.1.10",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vite": "^4.5.0",
    "vite-plugin-svgr": "^3.2.0"
  },
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "dependencies": {
    "@radix-ui/react-icons": "^1.3.2",
    "@types/uuid": "^10.0.0",
    "@unpic/react": "^1.0.1",
    "axios": "^1.10.0",
    "bcryptjs": "^3.0.2",
    "better-sqlite3": "^11.10.0",
    "dotenv": "^16.5.0",
    "drizzle-orm": "^0.44.1",
    "framer-motion": "^12.18.1",
    "pg": "^8.16.0",
    "uuid": "^11.1.0"
  },
  "engines": {
  "node": ">=18.0.0"
}
}
